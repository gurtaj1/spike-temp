#!/bin/sh
# Git credential helper for the read-only GitHub token. git runs it as whichever user is
# running git, and only agent can read the file, so for node it prints nothing.
#
# Only uses shell builtins for the token, so it never appears in a process's arguments.
TOKEN_FILE=/home/agent/.claude/github-readonly-token

# git also calls store and erase, and this has nothing to save or forget
[ "${1:-}" = get ] || exit 0

protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

# The file has no trailing newline, so read reports end of file even when it worked
token=
{ IFS= read -r token; } 2>/dev/null <"$TOKEN_FILE"
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$token"
